{
  "description": "Shared test vectors for the DAVHI clock-sync algorithm. Any implementation (Max, mobile client) should produce these results. All values are milliseconds.",
  "computeSample": [
    {
      "name": "monotonic clock behind the server",
      "t1": 1000, "serverTimestamp": 5000, "t4": 1040,
      "expected": { "monotonicOffset": 3980, "delay": 40, "error": 20 }
    },
    {
      "name": "monotonic clock ahead of the server",
      "t1": 9000, "serverTimestamp": 5000, "t4": 9010,
      "expected": { "monotonicOffset": -4005, "delay": 10, "error": 5 }
    },
    {
      "name": "fractional timestamps",
      "t1": 100.25, "serverTimestamp": 200, "t4": 103.75,
      "expected": { "monotonicOffset": 98, "delay": 3.5, "error": 1.75 }
    }
  ],
  "selectBestSample": [
    {
      "name": "lowest delay wins; first sample and failures are discarded",
      "samples": [
        { "monotonicOffset": 1, "delay": 5, "error": 2.5 },
        null,
        { "monotonicOffset": 5, "delay": 40, "error": 20 },
        { "monotonicOffset": 7, "delay": 22, "error": 11 },
        { "monotonicOffset": 6, "delay": 30, "error": 15 },
        null
      ],
      "expected": { "monotonicOffset": 7, "delay": 22, "error": 11 }
    },
    {
      "name": "only the warm-up sample succeeded",
      "samples": [{ "monotonicOffset": 1, "delay": 5, "error": 2.5 }, null, null],
      "expected": null
    },
    {
      "name": "every request failed",
      "samples": [null, null],
      "expected": null
    }
  ],
  "isBurstComplete": [
    {
      "name": "warm-up and one usable sample are not enough",
      "samples": [{ "delay": 244 }, { "delay": 47.4 }],
      "expected": false
    },
    {
      "name": "steady network: the second usable sample is within 2 ms",
      "samples": [{ "delay": 244 }, { "delay": 47.4 }, { "delay": 47.8 }],
      "expected": true
    },
    {
      "name": "exactly 2 ms apart counts as steady",
      "samples": [{ "delay": 244 }, { "delay": 40 }, { "delay": 42 }],
      "expected": true
    },
    {
      "name": "latest sample is more than 2 ms from the best",
      "samples": [{ "delay": 244 }, { "delay": 50 }, { "delay": 46.6 }],
      "expected": false
    },
    {
      "name": "compared with the best earlier sample, not the previous one",
      "samples": [{ "delay": 244 }, { "delay": 45.8 }, { "delay": 50 }, { "delay": 47 }],
      "expected": true
    },
    {
      "name": "the warm-up sample is not a comparison point",
      "samples": [{ "delay": 47 }, { "delay": 60 }, { "delay": 47.5 }],
      "expected": false
    },
    {
      "name": "a failed latest request does not stop the burst",
      "samples": [{ "delay": 244 }, { "delay": 47 }, null],
      "expected": false
    },
    {
      "name": "stops at 6 samples even if never steady",
      "samples": [{ "delay": 244 }, { "delay": 80 }, { "delay": 60 }, { "delay": 90 }, { "delay": 50 }, { "delay": 70 }],
      "expected": true
    }
  ],
  "shouldAccept": [
    {
      "name": "not synced yet",
      "current": null, "candidate": { "error": 500 }, "now": 0,
      "expected": true
    },
    {
      "name": "better error",
      "current": { "error": 10, "syncedAt": 0 }, "candidate": { "error": 4 }, "now": 60000,
      "expected": true
    },
    {
      "name": "exactly twice the current error",
      "current": { "error": 10, "syncedAt": 0 }, "candidate": { "error": 20 }, "now": 60000,
      "expected": true
    },
    {
      "name": "more than twice the current error, current is recent",
      "current": { "error": 10, "syncedAt": 0 }, "candidate": { "error": 20.5 }, "now": 60000,
      "expected": false
    },
    {
      "name": "current is exactly 5 minutes old",
      "current": { "error": 10, "syncedAt": 0 }, "candidate": { "error": 50 }, "now": 300000,
      "expected": false
    },
    {
      "name": "current is more than 5 minutes old",
      "current": { "error": 10, "syncedAt": 0 }, "candidate": { "error": 50 }, "now": 300001,
      "expected": true
    }
  ]
}
