# Copy this file to .env and set the values for the target performance server.
DAVHI_WEBSOCKET_URL="ws://localhost/api/performer"
# Sent as ?token=<token> on the WebSocket URL. The dev server accepts "dev".
DAVHI_PERFORMANCE_TOKEN="dev"
# Optional. The clock-sync endpoint, if it is not /api/time on the WebSocket's host.
# DAVHI_TIME_URL="http://localhost/api/time"
